<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fcry.App.ViewModels"
             xmlns:conv="using:Fcry.App.Converters"
             xmlns:app="using:Fcry.App"
             x:Class="Fcry.App.Views.MainScreenView"
             x:DataType="vm:MainScreenViewModel"
             Background="{DynamicResource AppBg}">

    <Grid RowDefinitions="48,*,28">

        <!-- Toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,16" Background="{DynamicResource AppBg}">

            <TextBlock Grid.Column="0"
                       Text="Fcry"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppLabel}"
                       VerticalAlignment="Center"
                       Margin="16 0"
                       Opacity="0.85" />

            <Border Grid.Column="1"
                    Background="#1aff453a"
                    BorderBrush="#55ff453a"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8 3"
                    Margin="0 0 8 0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding CountdownSeconds, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="Lock in"
                               FontSize="11"
                               Foreground="#ff6b6b"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountdownSeconds}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#ff453a"
                               VerticalAlignment="Center" />
                    <TextBlock Text="s"
                               FontSize="11"
                               Foreground="#ff6b6b"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Classes="toolbar"
                    Content="Lock"
                    Command="{Binding LockCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <Rectangle Grid.Row="0"
                   Fill="{DynamicResource AppSeparator}"
                   Height="1"
                   VerticalAlignment="Bottom" />

        <!-- Content -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto" Margin="16 12 16 0">

            <!-- Drop zone -->
            <Panel x:Name="DropZone"
                   Grid.Row="0"
                   Margin="0 0 0 10"
                   Background="Transparent">
                <Rectangle x:Name="DashNormal"
                           Stroke="{DynamicResource AppDropZoneBorder}"
                           StrokeThickness="1"
                           StrokeDashArray="6,3"
                           RadiusX="12"
                           RadiusY="12"
                           Fill="Transparent"
                           IsHitTestVisible="False" />
                <Rectangle x:Name="DashHover"
                           Stroke="#0a84ff"
                           StrokeThickness="1.5"
                           StrokeDashArray="6,3"
                           RadiusX="12"
                           RadiusY="12"
                           Fill="#0c0a84ff"
                           IsVisible="False"
                           IsHitTestVisible="False" />
                <StackPanel
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            IsHitTestVisible="False">
                    <PathIcon Data="{x:Static app:Icons.TrayDown}"
                              Width="36"
                              Height="36"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource AppElevated}" />
                    <TextBlock Text="Drop files or folders"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AppLabelTertiary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text=".fcry items are decrypted automatically"
                               FontSize="11"
                               Foreground="{DynamicResource AppSeparator}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>

            <!-- Action bar -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="2 0 2 10">
                <Button Grid.Column="0"
                        Content="Add Files…"
                        Command="{Binding AddFilesCommand}"
                        FontSize="12"
                        Padding="10 5" />
                <Button Grid.Column="1"
                        Content="Add Folder…"
                        Command="{Binding AddFolderCommand}"
                        FontSize="12"
                        Padding="10 5"
                        Margin="6 0 0 0" />

                <Grid Grid.Column="2"
                      ColumnDefinitions="Auto,Auto"
                      Margin="10 0 0 0"
                      VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                           Text="Delete originals"
                           FontSize="12"
                           Foreground="{DynamicResource AppLabelSecondary}"
                           VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1"
                          Classes="toggle"
                          IsChecked="{Binding DeleteOriginalAfter}"
                          Margin="8 0 0 0"
                          VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="Output:"
                               FontSize="11"
                               Foreground="{DynamicResource AppLabelTertiary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OutputDirectoryDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource AppLabelSecondary}"
                               VerticalAlignment="Center"
                               MaxWidth="160"
                               TextTrimming="CharacterEllipsis" />
                    <Button Content="Change"
                            Classes="ghost"
                            Command="{Binding ChangeOutputDirectoryCommand}"
                            FontSize="11"
                            Padding="6 2" />
                    <Button Classes="ghost"
                            Command="{Binding ClearOutputDirectoryCommand}"
                            Padding="4 2"
                            IsVisible="{Binding OutputDirectory, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <PathIcon Data="{x:Static app:Icons.Close}" Width="9" Height="9" />
                    </Button>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Cancel"
                        Command="{Binding CancelProcessingCommand}"
                        IsVisible="{Binding IsProcessing}"
                        Background="#1aff453a"
                        Foreground="#ff453a"
                        FontSize="12"
                        Padding="10 5"
                        Margin="6 0 0 0" />
            </Grid>

            <!-- Queue -->
                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" IsVisible="{Binding HasFiles}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4 0 4 6">
                    <TextBlock Grid.Column="0"
                               Text="QUEUE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppLabelTertiary}"
                               LetterSpacing="1"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Clear done"
                            Classes="ghost"
                            Command="{Binding ClearQueueCommand}" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource AppSurface}"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <ScrollViewer MaxHeight="200">
                        <ItemsControl ItemsSource="{Binding FileQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileQueueItem">
                                    <Border BorderBrush="{DynamicResource AppSeparator}"
                                            BorderThickness="0 0 0 1"
                                            Padding="14 0">
                                        <Grid Height="44" ColumnDefinitions="22,*,Auto,Auto">
                                            <PathIcon Grid.Column="0"
                                                      Data="{Binding OperationIcon, Converter={x:Static conv:AppConverters.IconKeyToGeometry}}"
                                                      Width="16"
                                                      Height="16"
                                                      HorizontalAlignment="Left"
                                                      Foreground="{DynamicResource AppLabelSecondary}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource AppLabel}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Value="{Binding Progress}"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             IsVisible="{Binding Status, Converter={x:Static conv:AppConverters.StatusIsProcessing}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Status, Converter={x:Static conv:AppConverters.StatusToBrush}}" />
                                            <Button Grid.Column="3"
                                                    Content="Show"
                                                    Classes="ghost"
                                                    Command="{Binding RevealInExplorerCommand}"
                                                    IsVisible="{Binding OutputPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    FontSize="11"
                                                    Padding="8 2"
                                                    Margin="4 0 0 0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource AppSeparator}"
                BorderThickness="0 1 0 0"
                Padding="20 0">
            <TextBlock Text="{Binding FileQueue.Count, StringFormat='{}{0} item(s) in queue'}"
                       FontSize="11"
                       Foreground="{DynamicResource AppLabelTertiary}"
                       VerticalAlignment="Center" />
        </Border>

    </Grid>
</UserControl>
