<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fcry.App.ViewModels"
             xmlns:conv="using:Fcry.App.Converters"
             x:Class="Fcry.App.Views.MainScreenView"
             x:DataType="vm:MainScreenViewModel"
             Background="#1c1c1e">

    <Grid RowDefinitions="52,*,28">

        <!-- ── Titlebar row (52 px — matches macOS toolbar height) ── -->
        <!-- Left 80 px stays empty so traffic-light buttons are never covered -->
        <Panel Grid.Row="0"
               x:Name="TitleBar"
               Background="Transparent">
            <Grid ColumnDefinitions="80,*,Auto,16">

                <!-- traffic-light clearance -->
                <Panel Grid.Column="0" />

                <!-- window title — centre of remaining space; also the drag region -->
                <TextBlock Grid.Column="1"
                           Text="Fcry"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#ebebf5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.85" />

                <!-- countdown + lock -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <Border Background="#ff453a1a"
                            BorderBrush="#ff453a55"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8 3"
                            IsVisible="{Binding CountdownSeconds, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="Lock in"
                                       FontSize="11"
                                       Foreground="#ff6b6b"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountdownSeconds}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#ff453a"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="s"
                                       FontSize="11"
                                       Foreground="#ff6b6b"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Classes="toolbar"
                            Content="Lock"
                            Command="{Binding LockCommand}" />
                </StackPanel>

            </Grid>
        </Panel>

        <!-- thin separator under toolbar -->
        <Rectangle Grid.Row="0"
                   Fill="#38383a"
                   Height="1"
                   VerticalAlignment="Bottom" />

        <!-- ── Content area ─────────────────────────────────────── -->
        <Grid Grid.Row="1"
              RowDefinitions="*,Auto"
              Margin="16 12 16 0">

            <!-- Drop zone with dashed border (Rectangle supports StrokeDashArray) -->
            <Panel Grid.Row="0" Margin="0 0 0 12">

                <!-- Normal dashed border -->
                <Rectangle x:Name="DashNormal"
                           Stroke="#48484a"
                           StrokeThickness="1"
                           StrokeDashArray="6,3"
                           RadiusX="12"
                           RadiusY="12"
                           Fill="Transparent" />

                <!-- Hover dashed border (toggled in code-behind) -->
                <Rectangle x:Name="DashHover"
                           Stroke="#0a84ff"
                           StrokeThickness="1.5"
                           StrokeDashArray="6,3"
                           RadiusX="12"
                           RadiusY="12"
                           Fill="#0a84ff0c"
                           IsVisible="False" />

                <StackPanel x:Name="DropZone"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="↓"
                               FontSize="32"
                               FontWeight="Thin"
                               HorizontalAlignment="Center"
                               Foreground="#3a3a3c" />
                    <TextBlock Text="Drop files or folders"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#48484a"
                               HorizontalAlignment="Center" />
                    <TextBlock Text=".fcry items are decrypted automatically"
                               FontSize="11"
                               Foreground="#3a3a3c"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>

            <!-- ── Queue ────────────────────────────────────────── -->
            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  IsVisible="{Binding HasFiles}">

                <!-- Queue header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4 0 4 4">
                    <TextBlock Grid.Column="0"
                               Text="Queue"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#636366"
                               LetterSpacing="0.5"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Clear done"
                            Classes="ghost"
                            Command="{Binding ClearQueueCommand}" />
                </Grid>

                <!-- Queue rows -->
                <Border Grid.Row="1"
                        Background="#2c2c2e"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <ScrollViewer MaxHeight="200">
                        <ItemsControl ItemsSource="{Binding FileQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileQueueItem">
                                    <Border BorderBrush="#38383a"
                                            BorderThickness="0 0 0 1"
                                            Padding="14 0">
                                        <Grid Height="44" ColumnDefinitions="22,*,Auto">

                                            <!-- operation icon -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding OperationIcon}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center" />

                                            <!-- filename + progress bar -->
                                            <StackPanel Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalAlignment="Center"
                                                        Margin="8 0">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13"
                                                           Foreground="#ffffff"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Value="{Binding Progress}"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             IsVisible="{Binding Status, Converter={x:Static conv:AppConverters.StatusIsProcessing}}" />
                                            </StackPanel>

                                            <!-- status label -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Status, Converter={x:Static conv:AppConverters.StatusToBrush}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>

        <!-- ── Status bar ───────────────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="#38383a"
                BorderThickness="0 1 0 0"
                Padding="20 0">
            <TextBlock Text="{Binding FileQueue.Count, StringFormat='{}{0} item(s) in queue'}"
                       FontSize="11"
                       Foreground="#48484a"
                       VerticalAlignment="Center" />
        </Border>

    </Grid>
</UserControl>
