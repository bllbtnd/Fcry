<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fcry.App.ViewModels"
             x:Class="Fcry.App.Views.LockScreenView"
             x:DataType="vm:LockScreenViewModel"
             Background="{DynamicResource AppBg}">

    <Grid>
        <StackPanel MaxWidth="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="0">

            <TextBlock Text="🔐"
                       FontSize="44"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 16" />

            <TextBlock Text="Fcry"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppLabel}"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 6" />

            <TextBlock Text="Enter your passphrase to continue"
                       FontSize="13"
                       Foreground="{DynamicResource AppLabelTertiary}"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 28" />

            <TextBox x:Name="PassphraseBox"
                     Text="{Binding Passphrase}"
                     PasswordChar="●"
                     Watermark="Passphrase"
                     IsEnabled="{Binding !IsUnlocking}" />

            <Border Margin="0 8 0 0"
                    Background="{DynamicResource AppSurface}"
                    CornerRadius="8"
                    Padding="10 8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Key file"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppLabelTertiary}" />
                        <TextBlock Text="{Binding KeyFilePath, TargetNullValue='None selected'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppLabelSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Content="Choose"
                                Classes="ghost"
                                Command="{Binding BrowseKeyFileCommand}"
                                IsEnabled="{Binding !IsUnlocking}" />
                        <Button Content="✕"
                                Classes="ghost"
                                Command="{Binding ClearKeyFileCommand}"
                                IsVisible="{Binding KeyFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#ff453a"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0 12 0 0"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Content="{Binding UnlockButtonText}"
                    Classes="primary"
                    Command="{Binding UnlockCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="14"
                    Height="36"
                    Margin="0 16 0 0" />

        </StackPanel>
    </Grid>
</UserControl>
