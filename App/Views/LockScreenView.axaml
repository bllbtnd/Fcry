<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fcry.App.ViewModels"
             x:Class="Fcry.App.Views.LockScreenView"
             x:DataType="vm:LockScreenViewModel"
             Background="#0d0d1a">

    <Grid>
        <Border MaxWidth="380"
                Background="#13131f"
                BorderBrush="#1e1e3a"
                BorderThickness="1"
                CornerRadius="16"
                Padding="40 36"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BoxShadow="0 8 40 0 #40000000">

            <StackPanel Spacing="20">

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="FCRY"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#e94560"
                               HorizontalAlignment="Center"
                               LetterSpacing="10" />
                    <TextBlock Text="file encryption"
                               FontSize="11"
                               Foreground="#555577"
                               HorizontalAlignment="Center"
                               LetterSpacing="3" />
                </StackPanel>

                <Separator Background="#1e1e3a" Height="1" Margin="0 4" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Passphrase"
                               FontSize="12"
                               Foreground="#8888aa" />
                    <TextBox x:Name="PassphraseBox"
                             Text="{Binding Passphrase}"
                             PasswordChar="●"
                             Watermark="Enter your passphrase"
                             IsEnabled="{Binding !IsUnlocking}"
                             FontSize="14" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Key file (optional)"
                               FontSize="12"
                               Foreground="#8888aa" />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding KeyFilePath}"
                                 Watermark="None selected"
                                 IsReadOnly="True"
                                 IsEnabled="{Binding !IsUnlocking}"
                                 FontSize="12" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Margin="6 0 0 0"
                                Command="{Binding BrowseKeyFileCommand}"
                                IsEnabled="{Binding !IsUnlocking}"
                                FontSize="12" />
                        <Button Grid.Column="2"
                                Content="✕"
                                Margin="4 0 0 0"
                                Command="{Binding ClearKeyFileCommand}"
                                IsEnabled="{Binding KeyFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                FontSize="12" />
                    </Grid>
                </StackPanel>

                <Button Content="{Binding UnlockButtonText}"
                        Command="{Binding UnlockCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Padding="0 10"
                        Margin="0 4 0 0"
                        Background="#e94560"
                        Foreground="White"
                        CornerRadius="8" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#e94560"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="0 -4 0 0" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
