<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fcry.App.ViewModels"
        xmlns:views="using:Fcry.App.Views"
        x:Class="Fcry.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Fcry"
        Width="720"
        Height="520"
        MinWidth="600"
        MinHeight="420"
        Background="#0d0d1a"
        Icon="/Assets/icon.ico">

    <ContentControl Content="{Binding CurrentView}">
        <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:LockScreenViewModel}">
                <views:LockScreenView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MainScreenViewModel}">
                <views:MainScreenView />
            </DataTemplate>
        </ContentControl.DataTemplates>
    </ContentControl>
</Window>
