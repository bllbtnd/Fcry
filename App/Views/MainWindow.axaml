<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fcry.App.ViewModels"
        xmlns:views="using:Fcry.App.Views"
        x:Class="Fcry.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Fcry"
        Width="740"
        Height="540"
        MinWidth="580"
        MinHeight="440"
        Background="#1c1c1e"
        Icon="avares://Fcry/Assets/icon.png">

    <Window.KeyBindings>
        <KeyBinding Gesture="Meta+L" Command="{Binding LockCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
    </Window.KeyBindings>

    <ContentControl Content="{Binding CurrentView}">
        <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:LockScreenViewModel}">
                <views:LockScreenView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MainScreenViewModel}">
                <views:MainScreenView />
            </DataTemplate>
        </ContentControl.DataTemplates>
    </ContentControl>
</Window>
